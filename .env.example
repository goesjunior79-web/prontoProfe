# ─── Chaves de API dos provedores de IA ──────────────────────────────────────

# Anthropic (Claude) — obrigatório para o plano gratuito
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (ChatGPT) — necessário para plano Pro
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Google (Gemini) — necessário para plano Pro
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxx

# Microsoft / Azure OpenAI (Copilot) — necessário para plano Escola
AZURE_OPENAI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com/openai/deployments/gpt-4-turbo/chat/completions

# ─── Autenticação (NextAuth) ──────────────────────────────────────────────────
# Gere um secret seguro: openssl rand -base64 32
NEXTAUTH_SECRET=seu-secret-aqui
# URL base do app (no desenvolvimento: http://localhost:3000)
NEXTAUTH_URL=https://seu-app.vercel.app

# ─── Google OAuth (para login com Google) ────────────────────────────────────
# Crie em: https://console.cloud.google.com > APIs & Services > Credentials
# Tipo: "OAuth 2.0 Client ID" (Web application)
# Redirect URI autorizada: https://seu-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxx

# ─── Google Drive (Client ID público — aparece no frontend) ──────────────────
# Pode ser o mesmo GOOGLE_CLIENT_ID se configurado corretamente
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ─── OneDrive / Microsoft (Client ID público) ────────────────────────────────
# Registre em: https://portal.azure.com > App registrations
# Permissão: Files.ReadWrite, User.Read | Redirect URI: http://localhost:3000
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Obtenha em: https://supabase.com > seu projeto > Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxx

# ─── Opcional: pagamentos (Stripe) ────────────────────────────────────────────
# STRIPE_SECRET_KEY=sua_chave_stripe_secreta
# STRIPE_WEBHOOK_SECRET=seu_webhook_secret
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=sua_chave_stripe_publica
