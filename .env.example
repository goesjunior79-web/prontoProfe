# ─── Chaves de API dos provedores de IA ───────────────────────────────────────
# Adicione no painel da Vercel em: Settings > Environment Variables

# Anthropic (Claude) — obrigatório para o plano gratuito
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (ChatGPT) — necessário para plano Pro
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Google (Gemini) — necessário para plano Pro
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxx

# Microsoft / Azure OpenAI (Copilot) — necessário para plano Escola
# Configure em: https://portal.azure.com > Azure OpenAI
AZURE_OPENAI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com/openai/deployments/gpt-4-turbo/chat/completions

# ─── Mock de desenvolvimento (sem créditos de API) ────────────────────────────
# Defina como true para retornar respostas fictícias sem chamar nenhuma API real
# Útil para testar o fluxo da UI enquanto os créditos estão esgotados
NEXT_PUBLIC_MOCK_AI=false

# ─── Integração nuvem (Google Drive / OneDrive) ───────────────────────────────
# Veja instruções completas de setup em: docs/guides/cloud-setup.md

# Google Drive — OAuth2 Client ID (criado no Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# OneDrive — Client ID do app registrado no Azure Entra ID
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Opcional: pagamentos (Stripe) ────────────────────────────────────────────
# Quando for implementar cobrança, adicione aqui
# STRIPE_SECRET_KEY=<sua-chave-secreta-stripe>
# STRIPE_WEBHOOK_SECRET=<seu-webhook-secret-stripe>
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<sua-chave-publica-stripe>
